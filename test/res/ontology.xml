<?xml version="1.0" encoding="UTF-8"?>
<rdf:RDF
    xml:base="http://example.com/ontology#"
    xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
    xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
    xmlns:owl="http://www.w3.org/2002/07/owl#">

    <owl:Ontology rdf:about="my-ontology">
        <owl:versionIRI rdf:resource="v1"/>
        <owl:imports rdf:resource="imported-ontology1"/>
        <owl:imports rdf:resource="imported-ontology2"/>
        <rdfs:comment xml:lang="en">This is ontology example.</rdfs:comment>
        <rdfs:comment xml:lang="fr">Ceci est un exemple d'ontologie.</rdfs:comment>
    </owl:Ontology>

</rdf:RDF>

