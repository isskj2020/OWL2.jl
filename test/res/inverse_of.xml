<?xml version="1.0"?>

<!DOCTYPE rdf:RDF [
    <!ENTITY owl "http://www.w3.org/2002/07/owl#" >
    <!ENTITY xsd "http://www.w3.org/2001/XMLSchema#" >
    <!ENTITY rdfs "http://www.w3.org/2000/01/rdf-schema#" >
    <!ENTITY rdf "http://www.w3.org/1999/02/22-rdf-syntax-ns#" >
]>
<rdf:RDF xmlns="https://raw.githubusercontent.com/owlcs/pizza-ontology/refs/heads/master/pizza.owl#"
     xml:base="https://raw.githubusercontent.com/owlcs/pizza-ontology/refs/heads/master/pizza.owl"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:owl="http://www.w3.org/2002/07/owl#">

    <owl:ObjectProperty rdf:about="#hasTopping">
        <rdfs:comment xml:lang="en"
            >Note that hasTopping is inverse functional because isToppingOf is functional</rdfs:comment>
        <rdf:type rdf:resource="&owl;InverseFunctionalProperty"/>
        <owl:inverseOf>
            <owl:ObjectProperty rdf:about="#isToppingOf"/>
        </owl:inverseOf>
    </owl:ObjectProperty>
</rdf:RDF>
