<?xml version="1.0"?>
<rdf:RDF
    xml:base="http://example.com/ontology#"
    xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
    xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
    xmlns:owl="http://www.w3.org/2002/07/owl#"
    xmlns:ex="https://example.com/ontology#">

    <owl:ObjectProperty rdf:about="#hasParent">
        <rdfs:label>has parent</rdfs:label>
        <owl:propertyDisjointWith
            rdf:resource="#hasChild"/>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="#hasChild">
        <rdfs:label>has child</rdfs:label>
    </owl:ObjectProperty>

    <!-- Individuals -->
    <rdf:Description rdf:about="#Alice">
        <ex:hasParent rdf:resource="#Bob"/>
    </rdf:Description>

    <!-- This statement conflicts with property disjointness -->
    <rdf:Description rdf:about="#Alice">
        <ex:hasChild rdf:resource="#Bob"/>
    </rdf:Description>

    <owl:DatatypeProperty rdf:about="#hasEmail">
        <rdfs:label>has email</rdfs:label>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>

        <owl:propertyDisjointWith
            rdf:resource="#hasUsername"/>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="#hasUsername">
        <rdfs:label>has username</rdfs:label>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>

    <rdf:Description rdf:about="#Alice">
        <ex:hasEmail>alice</ex:hasEmail>
        <ex:hasUsername>alice</ex:hasUsername>
    </rdf:Description>

</rdf:RDF>

